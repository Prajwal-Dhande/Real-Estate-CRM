# EstateIQ - Server Environment Variables

# Express Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/estateiq

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# AI Engine
AI_ENGINE_URL=http://localhost:8000/api/v1

# CORS
CLIENT_URL=http://localhost:3000
